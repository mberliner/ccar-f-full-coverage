{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python docs/hooks/hooks_escenarios_shell.py exit2",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python docs/hooks/hooks_escenarios_shell.py post-exit2"
          }
        ]
      }
    ]
  }
}
